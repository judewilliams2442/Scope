{
  "manifest_version": 3,    
  "name": "Scope",
  "version": "0.1.0",
  "description": "Understand what a website's privacy policy and Terms of Service say.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://heroic-banoffee-57c451.netlify.app/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scope - policy and terms analysis"
  },
  "icons": {
    "16": "16.png",
    "48": "48.png",
    "128": "128.png"
  }
}
