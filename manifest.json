{
  "manifest_version": 3,    
  "name": "Scope",
  "version": "0.1.0",
  "description": "Understand what a website's privacy policy says about your data.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://harness-ascte.netlify.app/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scope - privacy policy analysis"
  },
  "icons": {
    "16": "16.png",
    "48": "48.png",
    "128": "128.png"
  }
}
